# ── SARA SCF-ESIGN environment variables ──────────────────────────────────────
# Copy to .env and fill in values before deploying.

# Required — HMAC-SHA3-512 secret for envelope auth and audit ledger HMAC
# Must be >= 32 characters. Same secret used for both crypto envelope and ledger.
SCF_ESIGN_HMAC_SECRET=change-me-min-32-chars

# Required — per-actor credential secret for password-component TOTP auth
SCF_ESIGN_CREDENTIAL_SECRET=change-me-credential-secret

# Required — shared TOTP secret for SHA3-512 HOTP generation
SCF_ESIGN_TOTP_SECRET=change-me-totp-secret

# Optional — pin the Ed25519 signing key (hex-encoded 32-byte seed)
# If unset, a fresh key is generated per process start (dev only)
# SCF_ESIGN_ED25519_SEED_HEX=

# Set to "development" to enable /docs, /redoc, /openapi.json
SARA_ENV=production

PORT=8080
